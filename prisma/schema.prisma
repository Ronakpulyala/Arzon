generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HR
  EMPLOYEE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  SICK
  CASUAL
  EARNED
  UNPAID
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  ON_LEAVE
}

model User {
  id             String     @id @default(cuid())
  name           String
  email          String     @unique
  passwordHash   String
  role           Role       @default(EMPLOYEE)
  department     String?
  designation    String?
  dateJoined     DateTime   @default(now())
  isActive       Boolean    @default(true)
  baseSalary     Float      @default(0)
  // Fraction of closed-won deal value paid as commission, e.g. 0.05 = 5%.
  commissionRate Float      @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  attendance    Attendance[]
  leaves        Leave[]
  salaries      Salary[]
  salesReports  SalesReport[]
}

model Attendance {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime          @db.Date
  loginAt        DateTime?
  logoutAt       DateTime?
  status         AttendanceStatus  @default(PRESENT)
  hoursLogged    Float?
  // Break tracking: breakStartedAt is set while a break is in progress, then
  // cleared and folded into breakMinutes (total for the day) when it ends.
  breakStartedAt DateTime?
  breakMinutes   Int               @default(0)
  notes          String?
  createdAt      DateTime          @default(now())

  @@unique([userId, date])
  @@index([date])
}

model Leave {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       LeaveType
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  reason     String
  status     LeaveStatus @default(PENDING)
  reviewedBy String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Salary {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month         Int
  year          Int
  basic         Float
  allowances    Float    @default(0)
  deductions    Float    @default(0)
  bonus         Float    @default(0)
  netPay        Float
  paidOn        DateTime?
  payslipUrl    String?
  createdAt     DateTime @default(now())

  @@unique([userId, month, year])
}

enum SalesStatus {
  LEAD
  IN_PROGRESS
  CLOSED_WON
  CLOSED_LOST
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  OTHER
}

model SalesReport {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientName   String
  courseOrPlan String
  dealValue    Float
  status       SalesStatus   @default(IN_PROGRESS)
  reportDate   DateTime @db.Date
  remarks      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payments     SalesPayment[]

  @@index([reportDate])
  @@index([status])
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentType {
  ADVANCE // Pre-payment, taken before the deal is fully delivered
  FINAL   // Post-payment, the closing balance on a deal
  FULL    // One-shot payment covering the whole deal value
}

model SalesPayment {
  id            String        @id @default(cuid())
  salesReportId String
  salesReport   SalesReport   @relation(fields: [salesReportId], references: [id], onDelete: Cascade)
  amount        Float
  type          PaymentType   @default(FULL)
  method        PaymentMethod @default(BANK_TRANSFER)
  paidOn        DateTime      @db.Date
  reference     String?
  notes         String?
  status        PaymentStatus @default(PENDING)
  approvedBy    String?
  createdAt     DateTime      @default(now())

  @@index([salesReportId])
  @@index([paidOn])
  @@index([status])
}
